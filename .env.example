# ---------------------------------------------------------------------------
# AFTO Connect — environment variables
# Copy this file to `.env.local` and fill in real values.
# NEVER commit `.env.local`. Only NEXT_PUBLIC_* vars are exposed to the browser.
# ---------------------------------------------------------------------------

# Public site URL. Used for QR codes, vCards, Open Graph and magic-link redirects.
# Local dev: http://localhost:3000  |  Production: your Vercel/custom domain.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase -------------------------------------------------------------
# From your Supabase project: Settings → API.
# Local dev with `npx supabase start` prints these values in the terminal.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only. Bypasses RLS — used exclusively by the seed script and trusted
# server code. NEVER expose this to the browser or prefix it with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- AI provider (V1.1) ---------------------------------------------------
# MVP ships a mocked provider; no key required. Set this to switch providers
# once real AI is wired in (see src/lib/ai/README).
# AI_PROVIDER=mock            # mock | anthropic | openai
# ANTHROPIC_API_KEY=
